{
  "name": "npm-vs-pnpm-benchmark",
  "version": "1.0.0",
  "description": "Scientific benchmark system to compare npm vs pnpm performance",
  "type": "module",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "benchmark:npm": "node scripts/benchmark.js --package-manager npm",
    "benchmark:pnpm": "node scripts/benchmark.js --package-manager pnpm",
    "benchmark:both": "node scripts/benchmark.js --package-manager both",
    "benchmark:clean": "node scripts/benchmark.js --clean",
    "benchmark:warm": "node scripts/benchmark.js --warm",
    "benchmark:ci": "node scripts/benchmark.js --ci",
    "benchmark:mass": "node scripts/benchmark.js --mass",
    "benchmark:report": "node scripts/generate-report.js",
    "benchmark:charts": "node scripts/generate-charts.js",
    "benchmark:environment": "node scripts/collect-environment.js",
    "benchmark:validate": "node scripts/benchmark.js --validate",
    "generate:projects": "node scripts/generate-projects.js"
  },
  "keywords": [
    "benchmark",
    "npm",
    "pnpm",
    "performance",
    "package-manager"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "commander": "^12.0.0",
    "chart.js": "^3.9.1",
    "chartjs-node-canvas": "^4.1.6",
    "fast-glob": "^3.3.2",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "vitest": "^1.2.0"
  }
}
