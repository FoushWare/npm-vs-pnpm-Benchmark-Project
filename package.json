{
  "name": "npm-vs-pnpm-benchmark",
  "version": "1.0.0",
  "description": "Benchmark scripts comparing npm vs pnpm performance",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "benchmark": "node scripts/benchmark.js",
    "benchmark:install": "node scripts/benchmark.js --scenario install",
    "benchmark:dev": "node scripts/benchmark.js --low-memory",
    "benchmark:full": "node scripts/benchmark.js",
    "benchmark:live": "node scripts/benchmark.js --live-server",
    "benchmark:mass": "node scripts/benchmark.js --mass",
    "benchmark:mass:10": "node scripts/benchmark.js --mass --mass-count 10",
    "benchmark:mass:100": "node scripts/benchmark.js --mass --mass-count 100",
    "benchmark:mass:500": "node scripts/benchmark.js --mass --mass-count 500",
    "generate:projects": "node scripts/generate-projects.js",
    "generate:projects:10": "node scripts/generate-projects.js --count 10",
    "generate:projects:100": "node scripts/generate-projects.js --count 100",
    "generate:projects:500": "node scripts/generate-projects.js --count 500",
    "migrate:to-pnpm": "node scripts/migrate-to-pnpm.js",
    "ci:summary": "node scripts/generate-ci-summary.js results/ci",
    "results": "node scripts/show-results.js",
    "charts": "node scripts/generate-charts.js",
    "charts:terminal": "node scripts/generate-terminal-charts.js",
    "charts:browser": "node scripts/generate-browser-charts.js",
    "charts:live": "node scripts/generate-browser-charts.js --live-server",
    "clean:all": "node scripts/clean-all.js",
    "benchmark:cold:npm": "node scripts/benchmark-cold-npm.js",
    "benchmark:cold:pnpm": "node scripts/benchmark-cold-pnpm.js",
    "benchmark:warm:npm": "node scripts/benchmark-warm-npm.js",
    "benchmark:warm:pnpm": "node scripts/benchmark-warm-pnpm.js",
    "benchmark:disk": "node scripts/benchmark-disk.js",
    "benchmark:all:cold": "node scripts/benchmark-all-cold.js",
    "benchmark:all:warm": "node scripts/benchmark-all-warm.js",
    "benchmark:all": "node scripts/benchmark-all.js",
    "benchmark:all:low-memory": "node scripts/benchmark-all.js --low-memory",
    "ci:benchmark:npm": "node scripts/ci-benchmark-npm.js",
    "ci:benchmark:pnpm": "node scripts/ci-benchmark-pnpm.js"
  },
  "keywords": [
    "benchmark",
    "npm",
    "pnpm",
    "performance",
    "package-manager"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "commander": "^12.0.0",
    "chart.js": "^3.9.1",
    "chartjs-node-canvas": "^4.1.6",
    "fast-glob": "^3.3.2",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "vitest": "^1.2.0"
  }
}
