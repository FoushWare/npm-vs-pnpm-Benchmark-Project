{
  "name": "npm-vs-pnpm-benchmark",
  "version": "1.0.0",
  "description": "Scientific benchmark system to compare npm vs pnpm performance",
  "type": "module",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "benchmark:all": "node scripts/run-all-benchmarks.js",
    "benchmark:install": "node scripts/benchmark.js --scenario install --low-memory",
    "benchmark:build": "node scripts/benchmark.js --scenario build --low-memory",
    "benchmark:lint": "node scripts/benchmark.js --scenario lint --low-memory",
    "benchmark:low-memory": "node scripts/benchmark.js --package-manager both --low-memory",
    "benchmark:report": "node scripts/generate-report.js",
    "benchmark:charts": "node scripts/generate-charts.js"
  },
  "keywords": [
    "benchmark",
    "npm",
    "pnpm",
    "performance",
    "package-manager"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "commander": "^12.0.0",
    "chart.js": "^3.9.1",
    "chartjs-node-canvas": "^4.1.6",
    "fast-glob": "^3.3.2",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "vitest": "^1.2.0"
  }
}
